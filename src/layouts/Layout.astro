---
import "../styles/global.css";
import Header from '../components/header-footer/Header.astro';
import Footer from '../components/header-footer/Footer.astro';

const { title = "your space for growth, your space to move ahead", 
		description = "Warehouster is a Largest logistics and warehousing parks in Chennai, South India. It provides top-tier industrial and logistics parks warehousing solutions.",
		url = "/",
		ogTitle= "your space for growth, your space to move ahead",
		ogDescription = "Warehouster is a Largest logistics and warehousing parks in Chennai, South India. It provides top-tier industrial and logistics parks warehousing solutions.",
		type = "website",
		ogUrl = "/",
		ogImage = "",
		twTitle = "your space for growth, your space to move ahead",
		twDescription = "Warehouster is a Largest logistics and warehousing parks in Chennai, South India. It provides top-tier industrial and logistics parks warehousing solutions.",
		twImage = "/"
	} = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/images/logo/fav-icon.webp" />

		<title>{ title }</title>
		<meta name="description" content={ description } >
		<link rel="canonical" href={url} />

		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={twTitle} />
		<meta name="twitter:description" content={twDescription} />
		<meta name="twitter:image" content={twImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Gorditas:wght@400;700&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
		<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
	</head>
	<body class="font-(--font-display) bg-[#F6F6F6] relative">
		<Header />
			<slot />
		<Footer />
	</body>
</html>