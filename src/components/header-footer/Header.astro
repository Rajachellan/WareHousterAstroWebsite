---
import { Image } from "astro:assets";
import { ChevronDown, LandPlot, BrainCircuit, Layers, PackageCheck, FolderKey, Newspaper, PenLine, CalendarDays } from "@lucide/astro";
---

<>
<header class="w-full mt-2.5 px-4 fixed z-50">
    <div class="w-full flex-center rounded-md xl:rounded-lg">
        <div class="w-full max-w-6xl drop-shadow-md">
            <div class="w-full flex items-center justify-between lg:justify-start rounded-md xl:rounded-lg h-16 md:h-[68px] mx-auto px-3.5 gap-3.5 lg:gap-0 z-50 relative">
                <div class="py-4.5 pl-2 pr-10 md:py-4 md:px-7 lg:py-3.5 lg:px-8 mx-1.5 h-10/12 md:h-11/12">
                    <div class="h-full aspect-[5.788/1]">
                        <a href="/" class="h-full">
                            <Image src={"/images/logo/logo-icon.webp"} alt="logo" width="1042" height="180" class="h-full" loading="eager" />
                        </a>
                    </div>
                </div>
                <nav class="hidden lg:flex items-center justify-center w-full h-full">
                    <div class="w-full h-full flex-center justify-between">
                        <ul class="h-full flex-center font-medium text-gray-900">
                            <li class="h-full flex-center group/about cursor-pointer px-3.5 hover:text-[#F6670B]">
                                <div class="flex-center gap-0.5">
                                    <a href="/about" class="">
                                        About
                                    </a>
                                </div>
                            </li>
                            <li class="h-full flex-center group/service cursor-pointer px-3.5 bg-shade-header">
                                <div class="flex-center gap-0.5">
                                    <span class="group-hover/service:text-[#F6670B]">
                                        Offering
                                    </span>
                                    <span class="translate-y-[1px] group-hover/service:text-[#F6670B]">
                                        <ChevronDown size={26} stroke-width={1.2} class="group-hover/service:-rotate-180 transform-300" />
                                    </span>
                                    <div class="absolute group-hover/service:h-80 top-0 left-0 h-0 w-full transition-[height,drop-shadow] duration-500 delay-100 ease-in-out rounded-md xl:rounded-lg bg-[#F6F6F6] shadow-lg cursor-default -z-10 overflow-hidden">
                                        <div class="grid grid-cols-3 gap-x-3 px-7 pt-16 md:pt-[88px] pb-7 relative">
                                            <a href="/land-acquisition" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <LandPlot size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Land Acquisition</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">Warehouster excels in the crucial game of land acquisition</span>
                                                </div>
                                            </a>
                                            <a href="/warehouse-strategic-alliances" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <BrainCircuit size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Warehouse - Strategic Alliances</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">This strategic alliance brings together Warehouster's deep expertise</span>
                                                </div>
                                            </a>
                                            <a href="/development-management" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <Layers size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Development Management</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">We take on this challenge, making your land profitable through professional management</span>
                                                </div>
                                            </a>
                                            <a href="/approvals-and-compliances" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <PackageCheck size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Approvals and Compliances</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">Warehouster is experienced in statutory and regulatory framework Pan India</span>
                                                </div>
                                            </a>
                                            <a href="/asset-management" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <FolderKey size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Asset Management</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">This strategic alliance brings together Warehouster's deep expertise</span>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="h-full flex-center group/project cursor-pointer px-3.5 bg-shade-header">
                                <div class="flex-center gap-0.5">
                                    <span class="group-hover/project:text-[#F6670B]">
                                        Initiatives
                                    </span>
                                    <span class="translate-y-[1px] group-hover/project:text-[#F6670B]">
                                        <ChevronDown size={26} stroke-width={1.2} class="group-hover/project:-rotate-180 transform-300" />
                                    </span>
                                    <div class="absolute group-hover/project:h-[21rem] top-0 left-0 h-0 w-full transition-[height,drop-shadow] duration-500 delay-100 ease-in-out rounded-md xl:rounded-lg bg-[#F6F6F6] shadow-lg cursor-default -z-10 overflow-hidden">
                                        <div class="grid grid-cols-3 grid-rows-1 px-7 pt-16 md:pt-[88px] pb-7 relative lg:px-4">
                                            <div class="w-full flex flex-col border-r border-gray-200">
                                                <div class="w-full px-2 flex flex-col">
                                                    <p class="text-sm group-hover:text-[var(--primary-clr-lit)] text-gray-500 text-center">Developed</p>
                                                    <div class="w-full pt-3.5 px-3.5 flex flex-col">
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Redhills, <span class="text-[15px] text-gray-500">Chennai</span></h5>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="w-full p-2.5 flex-1">
                                                    
                                                </div>
                                            </div>
                                            <div class="w-full border-r border-gray-200">
                                                <div class="w-full px-2 flex flex-col">
                                                    <p class="text-sm group-hover:text-[var(--primary-clr-lit)] text-gray-500 text-center">In-Progress</p>
                                                    <div class="w-full pt-3.5 px-3.5 flex flex-col">
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Chengalpet, <span class="text-[15px] text-gray-500">Chennai</span></h5>
                                                        </a>
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Singhadivakkam, <span class="text-[15px] text-gray-500">Chennai</span></h5>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="w-full">
                                                <div class="w-full px-2 flex flex-col">
                                                    <p class="text-sm group-hover:text-[var(--primary-clr-lit)] text-gray-500 text-center">UpComing</p>
                                                    <div class="w-full pt-3.5 px-3.5 flex flex-col">
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Baglur, <span class="text-[15px] text-gray-500">Hosur</span></h5>
                                                        </a>
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Kiliyanur, <span class="text-[15px] text-gray-500">Pondichery</span></h5>
                                                        </a>
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Uthukadu, <span class="text-[15px] text-gray-500">Oragadam</span></h5>
                                                        </a>
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Sholavaram , <span class="text-[15px] text-gray-500">Chennai</span></h5>
                                                        </a>
                                                        <a href="/park/redhills" class="w-full px-4 py-1.5 hover:bg-white hover:shadow-xs rounded-md transform transition-[background-color] duration-200">
                                                            <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Vishnuvakkam, <span class="text-[15px] text-gray-500">Chennai</span></h5>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="h-full flex-center group/news cursor-pointer px-3.5 bg-shade-header">
                                <div class="flex-center gap-0.5">
                                    <span class="group-hover/news:text-[#F6670B]">
                                        Media
                                    </span>
                                    <span class="group-hover/news:text-[#F6670B] translate-y-[1px]">
                                        <ChevronDown size={26} stroke-width={1.2} class="group-hover/news:-rotate-180 transform-300" />
                                    </span>
                                    <div class="absolute group-hover/news:h-52 top-0 left-0 h-0 w-full transition-[height,drop-shadow] duration-500 delay-100 ease-in-out rounded-md xl:rounded-lg bg-[#F6F6F6] shadow-lg cursor-default -z-10 overflow-hidden">
                                        <div class="grid grid-cols-3 gap-x-3 px-7 pt-16 md:pt-[88px] pb-7 relative">
                                            <a href="/blogs" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <PenLine size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Blogs</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">Expert takes on inventory and fulfillment trends</span>
                                                </div>
                                            </a>
                                            <a href="/events" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <CalendarDays size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">Events</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">Networking events for warehouse leaders and partners</span>
                                                </div>
                                            </a>
                                            <a href="/news" class="w-full flex gap-3 items-start jusatify-start px-3 py-2 group hover:bg-[#FFFFFF] hover:shadow-xs rounded-md">
                                                <Newspaper size={28} stroke-width={1.5} class="mt-1 group-hover:text-[var(--primary-clr-lit)]" />
                                                <div class="flex-1 flex flex-col items-start jusatify-start">
                                                    <h5 class="text-base group-hover:text-[var(--primary-clr-lit)]">News</h5>
                                                    <span class="text-[15px] text-gray-500 leading-sung">Industry-first breakthroughs transforming warehouse intelligence</span>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="flex-center mx-1.5 h-full w-32">
                        <a href="/contact-us" class="text-nowrap px-5 py-1.5 bg-[var(--primary-clr-lit)] rounded-full relative overflow-hidden border border-[var(--primary-clr-lit)] group hover:bg-white transform transition-colors delay-100">
                            <span class="group-hover:-translate-y-10 text-white flex transform transition-transform duration-300">
                                Contact Us
                            </span>
                            <span class="z-10 after:content-['Contact_Us'] after:w-full after:h-full after:text-[var(--primary-clr-lit)] after:absolute after:top-10 after:left-1/2 after:-translate-x-1/2 group-hover:after:-translate-y-10 group-hover:translate-z-3 after:flex after:items-center after:justify-center after:z-10 after:transform after:transition-transform after:duration-300">
                            </span>
                        </a>
                    </div>
                </nav>
                <div class="flex lg:hidden items-center justify-center mr-3 md:mr-5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 md:w-7" ><path d="M3 4H21V6H3V4ZM3 11H21V13H3V11ZM3 18H21V20H3V18Z"></path></svg>
                </div>
                <div class="absolute w-full h-full top-0 left-0 bg-white -z-20 rounded-md">
                </div>
            </div>
            
        </div>
    </div>
    <div class="fixed w-screen h-screen top-0 left-0 bg-[#00000059] -z-10 hidden" id="bg-cover" ></div>
</header>
</>

<script>
    if (typeof window !== "undefined") {
        const allChild1 = document.querySelectorAll(".bg-shade-header");

        allChild1.forEach((el) => {
            const bgHover = document.getElementById('bg-cover');
            el.addEventListener("mouseenter", () => bgHover?.classList.remove("hidden"));
            el.addEventListener("mouseleave", () => bgHover?.classList.add("hidden"));
        })
    }
</script>