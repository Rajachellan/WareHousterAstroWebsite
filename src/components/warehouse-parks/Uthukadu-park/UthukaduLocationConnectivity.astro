
---
import { MapPinHouse, Factory, Component, Pickaxe, Plane, Building2, Ship, TrainFront,  } from "@lucide/astro";
import { Image } from 'astro:assets';
---

<section class="w-full col-center mx-auto px-5">
    <div class="w-full col-center gap-14 max-w-6xl mt-24 mb-10">
        <div class="col-center gap-2">
            <span class="flex-center gap-2 px-3.5 py-1 bg-white border border-[#e4e4e4] rounded-full">
                <MapPinHouse size={18} stroke-width={2} class="text-gray-800" />
                <h4 class="text-[13px] md:text-[15px] font-medium  text-gray-800">
                    Location & Connectivity
                </h4>
            </span>
            <h2 class="h2-bold text-center">
                Strategically Positioned for Seamless Access
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-400 md:text-gray-500 max-w-4xl text-center px-auto">
                Located in Madurai, our 30-acre Grade A industrial park offers compliant infrastructure, skilled workforce access, and proximity to major industrial and logistics hubs.
            </p>
        </div>
        <div class="w-full flex-center gap-5 rounded-md p-5">
            <div class="w-1/3 gap-3.5 px-7 py-6 flex flex-col items-start bg-white rounded-md">
                <Factory size={32} stroke-width={2} class="text-[var(--primary-color)]" />
                <div class="flex flex-col items-start">
                    <p class="md:text-lg lg:text-xl font-semibold">
                        Strategic Industrial Cluster
                    </p>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Spanning 30 acres along NH 38, the park is ideal for warehousing and industrial operations serving South Chennai.
                    </p>
                </div>
            </div>
            <div class="w-1/3 gap-3.5 px-7 py-6 flex flex-col items-start bg-white rounded-md">
                <Component size={32} stroke-width={2} class="text-[var(--primary-color)]" />
                <div class="flex flex-col items-start">
                    <p class="md:text-lg lg:text-xl font-semibold">
                        Thriving Tenant Ecosystem
                    </p>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Surrounded by Total, Jio, Asian Paints, GD Textiles, and Marvels, offering strong industrial and warehousing growth opportunities.
                    </p>
                </div>
            </div>
            <div class="w-1/3 gap-3.5 px-7 py-6 flex flex-col items-start bg-white rounded-md">
                <Pickaxe size={32} stroke-width={2} class="text-[var(--primary-color)]" />
                <div class="flex flex-col items-start">
                    <p class="md:text-lg lg:text-xl font-semibold">
                        Skilled Workforce Availability
                    </p>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Located 3.5 km from the airport and 15 km from the city, with access to SIDCO Industrial Estate.
                    </p>
                </div>
            </div>
        </div>
        <div class="w-full flex h-[470px] gap-5 rounded-md p-5 bg-white">
            <div class="w-[65%]">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d20739.61834992569!2d80.13643883948156!3d13.207118141695132!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a527d0e7054b3fb%3A0x217b2ab79be2a72!2sEdapalayam%20Auto%20Stand!5e0!3m2!1sen!2sin!4v1759972398934!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full h-full rounded-md"></iframe>
            </div>
            <div class="flex w-[35%] max-h-full bg-[#f7f7f7] rounded-md overflow-y-scroll px-4">
                <div class="w-full flex flex-col gap-2.5 pl-2">
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <Building2 size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Ambattur</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">20km</p>
                        </div>
                    </div>
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <Ship size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Chennai Port</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">35km</p>
                        </div>
                    </div>
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <TrainFront size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Chennai Cental Railway Station</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">20km</p>
                        </div>
                    </div>
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <Building2 size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Chennai CBD</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">33km</p>
                        </div>
                    </div>
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <Ship size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Ennore Port</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">40km</p>
                        </div>
                    </div>
                    <div class="w-full flex gap-3.5 p-3.5 bg-[#e2e9ff] border border-gray-300 rounded-sm">
                        <Plane size={30} stroke-width={1.5} class="text-[#091332]" />
                        <div class="flex flex-col">
                            <p class="text-sm lg:text-base leading-none text-gray-950 text-left">Airport</p>
                            <p class="text-sm lg:text-base leading-none text-gray-800 text-left font-extralight">42km</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>