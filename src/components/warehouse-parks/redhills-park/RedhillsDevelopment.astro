---
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center mx-auto px-5">
    <div class="w-full col-center gap-4 md:gap-6 lg:gap-8 px-1.5 py-5 max-w-6xl mt-24 mb-10">
        <div class="col-center gap-2 mb-10">
            <h2 class="h2-bold text-center">
                Architectural & Operational Excellence
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-400 md:text-gray-500 max-w-4xl text-center px-auto pt-4">
                Precision‑engineered structures, compliant systems, and optimized layouts ensure durability, efficiency, and scalability—delivering long‑term value for global occupiers.
            </p>
        </div>
        <div class="w-full flex items-stretch justify-center py-5 px-7 gap-4 md:gap-5 lg:gap-7 bg-white rounded-xl cursor-pointer mb-10 border border-gray-200 hover:-translate-y-1.5 hover:shadow-lg transform transition-transform duration-300">
            <div class="w-1/2 rounded-md overflow-hidden">
                <Image src="/images/upload/parks/park-interior.webp" alt="warehouse-redhills-development" width={530} height={360} class="w-full h-full object-cover object-center" />
            </div>
            <div class="w-1/2 flex flex-col justify-between rounded-md px-5 py-3.5" id="hoverPlayer">
                <div class="flex flex-col gap-0.5">
                    <div class="flex items-end gap-4">
                        <lottie-player id="craneLottie" src="/icons/crane.json" background="transparent" speed="1" style="width:64px;height:64px" loop ></lottie-player>
                        <h4 class="md:text-lg lg:text-xl font-bold">
                            Interior Excellence
                        </h4>
                    </div>
                    <p class="text-[13px] lg:text-[15px] leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Designed with natural lighting, durable walls, strong flooring, advanced fire safety, efficient ventilation, and dock-ready access for seamless operations
                    </p>
                    <div class="flex flex-wrap gap-3.5 text-[10px] md:text-xs lg:text-[12px] text-gray-800 my-1.5">
                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Lighting <span class="text-xs md:text-sm lg:text-base">3–5%</span> Skylights
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Walls <span class="text-xs md:text-sm lg:text-base">3.6m</span> Height
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Fire <span class="text-xs md:text-sm lg:text-base">K160/K80</span> Sprinklers
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Ventilation <span class="text-xs md:text-sm lg:text-base">3–6</span> Airchanges
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Dock <span class="text-xs md:text-sm lg:text-base">1.2m</span> Height
                        </span>
                    </div>
                </div>
                <div class="flex flex-col gap-0.5 py-2.5 border-t border-gray-300 mt-1.5">
                    <h4 class="text-[17px] md:text-[19px] lg:text-[25px] font-bold"> 
                        5T<span class="text-gary-700 font-text-sm mdLtext-base lg:text-xl font-medium">/sqm UDL Floor</span>
                    </h4>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-0.5">
                        supports heavy machinery, dense racking, and 3PL throughput—backbone of scalable logistics
                    </p>
                </div>
            </div>
        </div>
        <div class="w-full flex flex-row-reverse items-stretch justify-center py-5 px-7 gap-4 md:gap-5 lg:gap-7 bg-white rounded-xl cursor-pointer mb-10 border border-gray-200 hover:-translate-y-1.5 hover:shadow-lg transform transition-transform duration-300">
            <div class="w-1/2 rounded-md overflow-hidden">
                <Image src="/images/upload/parks/park-exterior.webp" alt="warehouse-redhills-development" width={530} height={360} class="w-full h-full object-cover object-center" />
            </div>
            <div class="w-1/2 flex flex-col justify-between rounded-md px-5 py-3.5" id="hoverPlayer">
                <div class="flex flex-col gap-0.5">
                    <div class="flex items-end gap-4">
                        <lottie-player id="craneLottie" src="/icons/crane.json" background="transparent" speed="1" style="width:64px;height:64px" loop ></lottie-player>
                        <h4 class="md:text-lg lg:text-xl font-bold">
                            Exterior Excellence
                        </h4>
                    </div>
                    <p class="text-[13px] lg:text-[15px] leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Built with galvalume roofing, wide truck aprons, optimized structures, high eave clearance, dedicated office space, ample parking, and 24×7 security
                    </p>
                    <div class="flex flex-wrap gap-3.5 text-[10px] md:text-xs lg:text-[12px] text-gray-800 my-1.5">
                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Roof – Galvalume Sheets
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Truck Apron – <span class="text-xs md:text-sm lg:text-base">16.5m</span> Width
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Structure – Pre‑Engineered Build
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Office Area – <span class="text-xs md:text-sm lg:text-base">2.5%</span> Mezzanine
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Parking – Peak Load Ready
                        </span>

                        <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                            Security – <span class="text-xs md:text-sm lg:text-base">24×7</span> CCTV
                        </span>
                    </div>
                </div>
                <div class="flex flex-col gap-0.5 py-2.5 border-t border-gray-300 mt-1.5">
                    <h4 class="text-[17px] md:text-[19px] lg:text-[25px] font-bold">
                        12m <span class="text-gary-700 font-text-sm mdLtext-base lg:text-xl font-medium">Eaves Building Height</span>
                    </h4>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-0.5">
                        The park enables high‑bay racking, advanced automation, and efficient vertical storage for scalable logistics
                    </p>
                </div>
            </div>
        </div>
        <div class="w-full flex items-stretch justify-center py-5 px-7 gap-4 md:gap-5 lg:gap-7 bg-white rounded-xl cursor-pointer mb-10 border border-gray-200 hover:-translate-y-1.5 hover:shadow-lg transform transition-transform duration-300">
            <div class="w-1/2 rounded-md overflow-hidden">
                <Image src="/images/upload/parks/park-operation.webp" alt="warehouse-redhills-development" width={530} height={360} class="w-full h-full object-cover object-center" />
            </div>
            <div class="w-1/2 flex flex-col justify-between rounded-md px-5 py-3.5" id="hoverPlayer">
                <div class="flex flex-col gap-0.5">
                    <div class="flex items-end gap-4">
                        <lottie-player id="craneLottie" src="/icons/crane.json" background="transparent" speed="1" style="width:64px;height:64px" loop ></lottie-player>
                        <h4 class="md:text-lg lg:text-xl font-bold">
                            Operational Excellence
                        </h4>
                    </div>
                    <p class="text-[13px] lg:text-[15px] leading-snug text-gray-500 text-left px-auto mt-1.5">
                        Uninterrupted operations with dual backup, compliance infrastructure, automated safety, scalable capacity, and smart connectivity.
                    </p>
                    <div class="flex flex-wrap gap-3.5 text-[10px] md:text-xs lg:text-[12px] text-gray-800 my-1.5">
                        <div class="flex flex-wrap gap-3.5 text-[10px] md:text-xs lg:text-[12px] text-gray-800 my-1.5">
                            <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                                Power Backup – Dual Source + DG Sets
                            </span>
                            <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                                Utility & Network Reliability
                            </span>
                            <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                                Seismic & Safety Standards
                            </span>
                            <span class="px-3.5 py-0.5 rounded-full bg-[#f7f7f7] border border-gray-200">
                                24×7 Manned + CCTV
                            </span>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col gap-0.5 py-2.5 border-t border-gray-300 mt-1.5">
                    <h4 class="text-[17px] md:text-[19px] lg:text-[25px] font-bold"> 
                        30-40 <span class="text-gary-700 font-text-sm mdLtext-base lg:text-xl font-medium">km Chennai Port & Airport</span>
                    </h4>
                    <p class="text-sm lg:text-base leading-snug text-gray-500 text-left px-auto mt-0.5">
                        Well‑connected site ensuring smooth access to port, airport, and key transport corridors
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
  // run after component is parsed
  window.addEventListener('DOMContentLoaded', () => {
    const hover = document.getElementById('hoverPlayer');
    const player = document.getElementById('craneLottie');
    if ((!player) || (!hover)) return;

    // start stopped at first frame
    player.stop();

    // Pointer interactions
    hover.addEventListener('mouseenter', () => player.play());
    hover.addEventListener('mouseleave', () => { player.stop(); player.goToAndStop(0, true); });

    // Keyboard accessibility
    hover.addEventListener('focus', () => player.play());
    hover.addEventListener('blur', () => { player.stop(); player.goToAndStop(0, true); });

    // Touch support: play on touchstart, reset on touchend
    hover.addEventListener('touchstart', () => player.play(), { passive: true });
    hover.addEventListener('touchend', () => { player.stop(); player.goToAndStop(0, true); });
  });
</script>


<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js" defer></script>