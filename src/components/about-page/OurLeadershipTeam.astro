---
import Image from "astro/components/Image.astro";
import { X } from '@lucide/astro';
import { CircleChevronLeft, CircleChevronRight } from "@lucide/astro";
import { getCollection } from 'astro:content';

const teams = await getCollection('leadershipTeam');
const sortedTeams = teams.sort((a, b) => a.data.id - b.data.id);
---

<section class="w-full col-center gap-4" x-data="{ showModal: false }">
    <div class="w-full flex flex-col gap-7 my-14 max-w-6xl">
        <div class="w-full col-center max-w-6xl">
            <h2 class="h2-bold text-center fade-in-up">
                Visionaries Behind Warehouster
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-500 max-w-3xl text-justify md:text-center px-auto pt-4 fade-in-up">
                We approach things with a unique perspective, actively seek opportunities with a flexible team and strive to deliver exceptional value to our customers, partners, and employees. 
            </p>
        </div>
        <div class="flex justify-end items-center gap-6 mr-10">
            <div class="cursor-pointer" id="scroll-left">
                <CircleChevronLeft size={24} strock-width={1} class="text-gray-400" />
            </div>
            <div class="cursor-pointer" id="scroll-right">
                <CircleChevronRight size={24} strock-width={1} class="text-gray-400"/>
            </div>
        </div>
        <div class="w-full max-w-full overflow-x-scroll scrollbar-none" id="case-studies-scroll">
            <div class="w-[125%] flex items-stretch justify-center mb-1.5 gap-5 xl:gap-8">
                {sortedTeams.map(team => (
                    <div class="w-1/5 max-w-1/5 flex flex-col gap-2.5 p-5 bg-white border border-gray-200 rounded-xl group cursor-pointer overflow-hidden relative fade-in-up" key={team?.data.name} id="case-studie">
                        <div class="w-full flex items-end justify-center aspect-square overflow-hidden">
                            <Image src={team?.data.image} alt={team?.data.name} width={230} height={230} class="object-center w-full h-full" />
                        </div>
                        <div class="w-full col-center gap-2 p-1.5">
                            <h6 class="text-(--primary-color) lg:text-lg font-bold transition-all duration-800 capitalize">
                                {team?.data.name}
                            </h6>
                            <h6 class="text-sm xl:text-base font-medium text-gray-700">{team?.data.role}</h6>
                            <div class="absolute flex items-end w-full h-full bottom-0 left-0 py-5 px-6 bg-[#000000a5] translate-y-full group-hover:translate-y-0 transform transition-transform duration-1000">
                                <p class="text-sm lg:text-base leading-snug text-white text-justify">
                                    {team?.data.description}
                                </p>
                            </div>
                        </div>
                    </div>
                    ))}
            </div>
        </div>
    </div>
</section>
