---
import Image from "astro/components/Image.astro";
---

<>
<section class="w-full flex-center mx-auto px-4 bg-white">
    <div class="w-full flex items-stretch gap-14 max-w-7xl mt-8 lg:mt-12 xl:mt-16 mb-10">
        <div class="w-1/2"></div>
        <div class="w-1/2 flex flex-col">
            <div class="flex flex-col">
                <h2 class="h2-bold text-left text-[#1A1A1A]">
                    We’re here to help
                </h2>
                <p class="md:text-lg xl:text-xl">Our dedicated team is ready to support you.</p>
            </div>
            <div class="flex flex-col">
                <div class="flex gap-5">
                    <div class="w-1/2">
                        <label for="first-name">First name</label>
                        <input type="text">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</>