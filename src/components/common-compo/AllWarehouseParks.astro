---
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center mx-auto px-5 bg-white">
    <div class="w-full col-center gap-4 md:gap-6 lg:gap-8 px-1.5 py-5 max-w-6xl mt-24 mb-10">
        <div class="col-center gap-2">
            <h2 class="h2-bold text-center">
                Browse Our All Logistics Parks and Facilities
            </h2>
        </div>
        <div class="w-full max-w-full">
            <div class="w-full max-w-full overflow-x-scroll">
                <div class="w-[266%] flex px-5 gap-5 items-stretch">
                    <div class="w-[12.5%] flex flex-col px-5 py-4 rounded-md border border-gray-200">
                        <Image src="/images/upload/parks/chennai-redhills-warehouse.webp" alt="chennai-redhills-warehouse" width={530} height={360} class="w-full object-cover object-center" loading="lazy" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>