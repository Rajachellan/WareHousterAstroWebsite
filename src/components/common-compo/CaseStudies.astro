---
import Image from "astro/components/Image.astro";
import { CircleChevronLeft, CircleChevronRight } from "@lucide/astro";
import { getCollection } from 'astro:content';

const casestudies = await getCollection('caseStudies');
---

<div class="w-full col-center gap-14 max-w-7xl mt-8 lg:mt-12 xl:mt-16 mb-10">
    <div class="col-center gap-0.5">
        <h2 class="h2-bold text-center mt-3 lg:mt-4 2xl:mt-5 fade-in-up">
            Case Studies - Warehouster Projects <span class="block">Across India</span>
        </h2>
        <p class="text-sm lg:text-base 2xl:text-lg leading-snug text-gray-500 max-w-4xl text-justify md:text-center px-auto mt-3 lg:mt-4 2xl:mt-5 fade-in-up">
            Explore diverse case studies showcasing innovative warehousing projects across India—highlighting strategic locations, scalable designs, and operational excellence tailored to regional logistics and supply chain demands.
        </p>
    </div>
    <div class="w-full flex flex-col gap-7">
        <!-- <div class="flex justify-end items-center gap-6 mr-10">
            <div class="cursor-pointer" id="scroll-left">
                <CircleChevronLeft size={24} strock-width={1} class="text-gray-400" />
            </div>
            <div class="cursor-pointer" id="scroll-right">
                <CircleChevronRight size={24} strock-width={1} class="text-gray-400"/>
            </div>
        </div> -->
        <div class="w-full max-w-full overflow-hidden scrollbar-custom" id="case-studies-scroll">
            <div class="w-full flex items-stretch justify-center mb-1.5 gap-5">
                {casestudies.map((study, index) => (
                    <div class="w-1/3 max-w-1/3 flex flex-col gap-2.5 p-5 bg-white border border-gray-200 rounded-xl group cursor-pointer fade-in-up" key={index} id="case-studie">
                        <div class="w-full aspect-[1.321/1] overflow-hidden rounded-xl">
                            <Image src={study?.data.image} alt={study?.data.title} width={555} height={420} class="object-center w-full group-hover:scale-105 transition-all duration-800" />
                        </div>
                        <div class="w-full col-center gap-2 p-1.5">
                            <h6 class="text-(--primary-clr-lit) group-hover:text-(--primary-color) lg:text-lg font-bold transition-all duration-800">
                                {study?.data.title}
                            </h6>
                            <h6 class="text-sm xl:text-base font-medium text-gray-700"><span class="text-gray-800 font-semibold xl:font-semibold xl:text-xl">{study?.data.area} </span>acres - <span class="text-gray-800 font-semibold xl:font-semibold xl:text-xl">{study?.data.buildArea} </span>Mn.Sq.Ft.</h6>
                            <p class="text-sm lg:text-base leading-snug text-gray-500 group-hover:text-gray-900 text-justify transition-all duration-800">
                                {study?.data.description}
                            </p>
                        </div>
                    </div>
                    ))}
            </div>
        </div>
    </div>
</div>

<style>
    .scrollbar-custom::-webkit-scrollbar {
    width: 2px; /* Reduced from 8px */
    }

    .scrollbar-custom::-webkit-scrollbar-track {
    background: #e7e7e7; /* Tailwind's gray-100 */
    }

    .scrollbar-custom::-webkit-scrollbar-thumb {
    background-color: #ff873c; /* Your brand orange */
    border-radius: 4px;
    border: 2px solid #e7e7e7;
    }

    .scrollbar-custom::-webkit-scrollbar-button {
    display: none;
    height: 0;
    }

    /* Firefox support */
    .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: #ff873c #e7e7e7;
    }

</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('case-studies-scroll');
    const scrollLeftBtn = document.getElementById('scroll-left');
    const scrollRightBtn = document.getElementById('scroll-right');

    if (!scrollContainer || !scrollLeftBtn || !scrollRightBtn) return;

    const scrollByFraction = () => scrollContainer.offsetWidth / 3;

    scrollLeftBtn.onclick = () => {
      scrollContainer?.scrollBy({ left: -scrollByFraction(), behavior: 'smooth' });
    };

    scrollRightBtn.onclick = () => {
      scrollContainer?.scrollBy({ left: scrollByFraction(), behavior: 'smooth' });
    };
  });
</script>
