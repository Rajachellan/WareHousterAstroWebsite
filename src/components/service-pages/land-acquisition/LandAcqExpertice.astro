---
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center gap-4">
    <div class="w-full max-w-6xl col-center gap-2 md:gap-18 xl:gap-20 mx-auto mt-10 py-20">
        <div class="col-flex">
            <h2 class="h2-bold text-center fade-in-up">
                <span class="block">Warehouster’s Expertise in Land Acquisition</span>Across Southern India
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-500 max-w-3xl text-justify md:text-center px-auto pt-4 fade-in-up">
                At Warehouster, we go beyond just procuring land — we master the full lifecycle of industrial land acquisition and approvals. With a track record across Chennai, Bengaluru, Hosur, Madurai, and adjoining industrial corridors, we ensure that your next warehouse or industrial park is built on land that maximises location, connectivity, regulatory compliance, and potential for growth.
            </p>
        </div>
        <div class="w-full flex items-start mt-4">
            <div class="w-[calc(25%+5rem)] min-w-[calc(25%+1.875rem)] aspect-square p-2.5 relative border-b-4 border-[#F6670B00] after:absolute after:w-[calc(100%-2.5rem)] after:h-1 after:bg-[#F6670B00] after:top-0 after:left-0 before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:bottom-0 before:right-0">
                <div class="w-full h-full p-2.5 bg-white rounded-lg border border-gray-100 shadow-sm before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:top-0 before:right-10 before:-translate-y-full fade-in-up">  
                    <div class="w-full h-full rounded-lg">
                        <Image src="/images/upload/land-acq-img-4.webp" alt="land-acquisition-img-4" width={345} height={346} class="w-full" />
                    </div>
                </div>
            </div>
            <div class="w-[calc(25%+5rem)] min-w-[calc(25%+1.875rem)] aspect-square p-2.5 relative border-t-4 border-[#F6670B00] -translate-y-10 -translate-x-10 after:absolute after:w-[calc(100%-5rem)] after:h-1 after:bg-[#F6670B00] after:bottom-0 after:left-1/2 after:-translate-x-1/2 before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:top-0 before:right-0">
                <div class="w-full h-full p-2.5 bg-white rounded-lg border border-gray-100 shadow-sm before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:bottom-0 before:right-10 before:translate-y-full fade-in-up">  
                    <div class="w-full h-full rounded-lg">
                        <Image src="/images/upload/land-acq-img-3.webp" alt="land-acquisition-img-3" width={345} height={346} class="w-full" />
                    </div>
                </div>
            </div>
            <div class="w-[calc(25%+5rem)] min-w-[calc(25%+1.875rem)] aspect-square p-2.5 relative border-b-4 border-[#F6670B00] -translate-x-20 after:absolute after:w-[calc(100%-5rem)] after:h-1 after:bg-[#F6670B00] after:top-0 after:left-1/2 after:-translate-x-1/2 before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:bottom-0 before:right-0">
                <div class="w-full h-full p-2.5 bg-white rounded-lg border border-gray-100 shadow-sm before:absolute before:w-1 before:h-10 before:bg-[#F6670B00] before:top-0 before:right-10 before:-translate-y-full fade-in-up">  
                    <div class="w-full h-full rounded-lg">
                        <Image src="/images/upload/land-acq-img-1.webp" alt="land-acquisition-img-1" width={345} height={346} class="w-full" />
                    </div>
                </div>
            </div>
            <div class="w-[calc(25%+5rem)] min-w-[calc(25%+1.875rem)] aspect-square p-2.5 relative border-t-4 border-[#F6670B00] -translate-y-10 -translate-x-30 after:absolute after:w-[calc(100%-2.5rem)] after:h-1 after:bg-[#F6670B00] after:bottom-0 after:right-0">
                <div class="w-full h-full p-2.5 bg-white rounded-lg border border-gray-100 shadow-sm fade-in-up">  
                    <div class="w-full h-full rounded-lg">
                        <Image src="/images/upload/land-acq-img-2.webp" alt="land-acquisition-img-2" width={345} height={346} class="w-full" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>