---
import { Sparkle, CheckCheck } from "@lucide/astro";
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center gap-4 bg-[url(/images/upload/approv-pattern.webp)]">
    <div class="w-full max-w-6xl col-center gap-2 md:gap-18 xl:gap-20 mx-auto my-12 md:my-18 lg:my-24">
        <div class="col-flex">
            <h2 class="h2-bold text-center">
                Our Pillars of Compliance
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-500 max-w-3xl text-justify md:text-center px-auto">
                In Warehouster, compliance is more than a requirement—it’s our promise. Every industrial park we develop stands on a strong foundation of legal security, transparency, and ethical responsibility. Our compliance framework is built on five essential pillars:
            </p>
        </div>
        <div class="w-full">
            <div class="w-full flex items-end justify-center gap-2.5">
                <div class="w-[65%]">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6">
                                <Sparkle size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                            </div>
                            <h5 class="h3-base font-semibold">
                                Statutory & Regulatory Excellence
                            </h5>
                        </div>
                        <div class="flex flex-col gap-2.5 ml-8">
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    100% adherence to Central and State laws.
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Securing land use approvals, zoning permits, and environmental clearances
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Obtaining building licenses, occupancy certificates, and safety approvals
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Ensuring all industrial parks are legally and operationally compliant
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="w-[35%] px-3 relative after:absolute after:w-full after:h-2.5 after:bg-linear-to-t after:from-[#F6F6F6] after:to-transparent after:bottom-0 after:left-0">
                    <Image src="/images/upload/approv-piller.webp" alt="pillers" width={475} height={376} class="w-full" />
                </div>
            </div>
            <div class="w-full flex items-end justify-end gap-2.5 pt-4 md:pt-5 lg:pt-6 xl:pt-7">
                <div class="w-[55%]">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6">
                                <Sparkle size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                            </div>
                            <h5 class="h3-base font-semibold">
                                Transparent & Fair Agreements
                            </h5>
                        </div>
                        <div class="flex flex-col gap-2.5 ml-8">
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Legally sound contracts and lease deeds with no hidden clauses
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Easy-to-understand terms for clients, investors, and stakeholders
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Focus on long-term trust, fairness, and legal clarity
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="w-full flex items-end justify-start gap-2.5 pt-4 md:pt-5 lg:pt-6 xl:pt-7">
                <div class="w-[55%]">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6">
                                <Sparkle size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                            </div>
                            <h5 class="h3-base font-semibold">
                                Verified Land Title & Legal Due Diligence
                            </h5>
                        </div>
                        <div class="flex flex-col gap-2.5 ml-8">
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Thorough title verification and ownership checks
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Investigation of litigation history, encumbrances, and land use compliance
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Risk-free land acquisition process backed by professional due diligence
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="w-full flex items-end justify-end gap-2.5 pt-4 md:pt-5 lg:pt-6 xl:pt-7">
                <div class="w-[55%]">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6">
                                <Sparkle size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                            </div>
                            <h5 class="h3-base font-semibold">
                                Ethical & Responsible Business Practices
                            </h5>
                        </div>
                        <div class="flex flex-col gap-2.5 ml-8">
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Zero tolerance for child labor, forced labor, corruption, or bribery
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Strict adherence to corporate governance and ESG standards
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Promoting sustainable and socially responsible business operations
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="w-full flex items-end justify-start gap-2.5 py-4 md:py-5 lg:py-6 xl:py-7">
                <div class="w-[55%]">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2.5">
                            <div class="w-6">
                                <Sparkle size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                            </div>
                            <h5 class="h3-base font-semibold">
                                Risk Management & Continuous Monitoring
                            </h5>
                        </div>
                        <div class="flex flex-col gap-2.5 ml-8">
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Proactive compliance tracking and statutory renewals
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Regular audits to minimize legal, regulatory, and environmental risks
                                </p>
                            </div>
                            <div class="flex items-start gap-2">
                                <div class="w-5">
                                    <CheckCheck size="100%" stroke-width={1.5} class="text-[var(--primary-color)]" />
                                </div>
                                <p class="text-sm lg:text-base leading-tight text-gray-500 text-justify px-auto">
                                    Adaptation to changing government policies and compliance updates
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>