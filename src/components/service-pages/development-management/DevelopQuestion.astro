---
import { ChevronUp } from "@lucide/astro";
---

<section class="w-full flex-center mx-auto px-4 bg-white">
    <div class="w-full col-center gap-14 max-w-6xl my-10 md:my-14 lg:my-20 xl:my-24">
        <div class="col-center gap-2">
            <h5 class="text-lg lg:text-2xl font-bold">
                Frequently Asked Questions
            </h5>
        </div>
        <div class="w-full max-w-2xl">
            <div class="w-full flex flex-col items-start group cursor-pointer bg-[#f6f6f6] px-5 py-2.5 rounded-md">
                <div class="w-fit flex gap-3.5 py-1 px-2.5">
                    <h6 class="lg:text-lg font-medium text-gray-900">
                        <span class="pr-1">1.</span> Can you manage existing development projects started by others?
                    </h6>
                    <ChevronUp class="" />
                </div>
                <span class="top-full h-0 group-hover:h-fit transform-[height] transition-transform duration-500 overflow-hidden">
                    <p class="text-sm lg:text-base text-gray-700 pt-2.5 ml-3.5 inline-block">
                        Yes, We evaluate the project status, identify gaps or risks, and then take over seamlessly to ensure completion within new timelines.
                    </p>
                </span>
            </div>
            <div class="w-full flex flex-col items-start group cursor-pointer bg-[#f6f6f6] px-5 py-2.5 rounded-md mt-5">
