---
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center z-0 gap-4 overflow-hidden">
    <div class="w-full aspect-[2.2/1] flex flex-col items-start justify-center relative bg-[url(/images/upload/bmi-strategic-alliance-banner.webp)] bg-no-repeat bg-cover bg-center gap-2.5 lg:gap-5"> 
        <div class="w-fit py-4 lg:py-6 px-7 lg:px-9 rounded-r-3xl">
            <h1 class="text-3xl md:4xl lg:text-5xl font-black text-[#004EA1] text-left text-wrap z-10 ml-7 md:ml-10 lg:ml-14 xl:ml-18 relative after:h-[175%] after:aspect-square after:absolute after:bottom-0 after:left-0 after:border-l-[6px] after:border-b-[6px] after:-translate-x-5 after:translate-y-5 after:rounded-tl-lg after:rounded-br-lg before:h-[175%] before:aspect-square before:absolute before:bottom-0 before:left-0 before:border-l-[6px] before:border-b-[6px] before:-translate-x-[31px] before:translate-y-[31px] before:rounded-tl-lg before:rounded-br-lg">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200%] -z-10">
                    <Image src="/images/upload/bg-blur-1.webp" alt="background-blur" width={1080} height={1080} class="w-full" />
                </div>
                <span class="block">
                    <span class="[-webkit-text-fill-color:transparent] [-webkit-text-stroke-width:1.5px] [-webkit-text-stroke-color:#004EA1] pr-0.5">B</span>uilding the future of Logistics
                </span>
                <span class="block">
                    <span class="[-webkit-text-fill-color:transparent] [-webkit-text-stroke-width:1.5px] [-webkit-text-stroke-color:#004EA1] pr-0.5">I</span>nfrastructure in <span class="[-webkit-text-fill-color:transparent] [-webkit-text-stroke-width:1.5px] [-webkit-text-stroke-color:#004EA1] pr-0.5">I</span>ndia
                </span>
            </h1>
        </div>
    </div>
</section>

