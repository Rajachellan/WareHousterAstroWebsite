<script>
    document.addEventListener('DOMContentLoaded', () => {
    const scrollContainer = document.getElementById('scroll-chennai-parks');
    const scrollLeftBtn = document.getElementById('scroll-left-park');
    const scrollRightBtn = document.getElementById('scroll-right-park');

    if (!scrollContainer || !scrollLeftBtn || !scrollRightBtn) return;

    const scrollByFraction = () => scrollContainer.offsetWidth / 1;

    scrollLeftBtn.onclick = () => {
      scrollContainer?.scrollBy({ left: -scrollByFraction(), behavior: 'smooth' });
    };

    scrollRightBtn.onclick = () => {
      scrollContainer?.scrollBy({ left: scrollByFraction(), behavior: 'smooth' });
    };
  });
</script>