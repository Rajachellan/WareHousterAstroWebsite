                                    <a href="#" class="flex-center gap-2 text-sm lg:text-base font-medium bg-[var(--secondary-clr-lit)] text-white px-4 py-1.5 rounded-full">
                                        <span class="">Explore Park</span>
                                        <SquareArrowUpRight size={18} stroke-width={1.5} />
                                    </a>
