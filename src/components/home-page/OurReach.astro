                            Back
                        </label>
                    </div>
                    <div class="flex flex-col px-5 py-2 gap-3.5">
                        <table class="border border-gray-200 border-collapse">
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="text-[20px] font-bold text-gray-700">4 </span>Major Cities
