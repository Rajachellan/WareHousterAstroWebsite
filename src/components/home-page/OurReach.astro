                        <table class="border-collapse">
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="font-bold text-gray-700">Accessibility</span>
                                    </h5>
                                </td>
                            </tr>
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5 flex">
                                    <h5 class="text-sm lg:text-base font-medium text-gray-600 flex gap-1">
                                        <PlaneTakeoff size={28} stroke-width={1} /> Airport - <span class="font-bold text-gray-700 pr-1.5">3.5 km</span>
                                    </h5>
                                    <h5 class="text-sm lg:text-base font-medium text-gray-600 flex gap-1 border-l border-gray-200 pl-1.5">
                                        <Building2 size={28} stroke-width={1} /> City - <span class="font-bold text-gray-700">15 km</span>
                                    </h5>
                                </td>
                            </tr>
                            <tr class="mt-2">
                                <td class="px-4 py-1.5 flex justify-end">
                                    <a href="#" class="flex-center gap-2 text-sm lg:text-base font-medium bg-[var(--secondary-clr-lit)] text-white px-4 py-1.5 rounded-full">
                                        <span class="">Explore Park</span>
                                        <SquareArrowUpRight size={18} stroke-width={1.5} />
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </div>
