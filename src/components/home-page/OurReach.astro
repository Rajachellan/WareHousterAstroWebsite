                            <div class="absolute w-full h-full rounded-full top-0 left-0 bg-[#1789dab2] animate-ping -z-10 scale-150"></div>
                            <span class="absolute top-full right-full bg-[#ffffff7d] px-3.5 py-1 text-nowrap border border-gray-300 rounded-l-md rounded-br-md">
                                Warehouse in Hosur
                            </span>
                        </div>
                    </label>
                </div>
            </div>
            <div class="w-1/2 flex items-center justify-center px-5 relative">
                <div id="location-zero" class="flex flex-col p-5 gap-4 rounded-sm border border-gray-200 shadow-sm bg-white location-section">
