                    </div>
                    <div class="w-full flex flex-col px-5 py-2.5 gap-3.5">
                        <Image src="/images/upload/parks/devanhalli-park.webp" alt="Banglore-warehouse" width={1920} height={1080} class="w-full rounded-sm" loading="lazy" />
                        <div class="flex justify-between gap-3.5 text-sm lg:text-base text-gray-800 font-semibold px-2.5">
                            <div class="">
                                <p class="text-gray-600 leading-tight">
                                    Land area
                                </p>
                                53 <span class="text-gray-400">Acres</span>
                            </div>
                            <div class="">
                                <p class="text-gray-600 leading-tight">
                                    Development
                                </p>
                                0.9 <span class="text-gray-400">MN SQ FT</span>
                            </div>
                            <div class="">
                                <span class="text-gray-500">Industrial & Warehousing</span>
                            </div>
                        </div>
                        <table class="border-collapse">
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="font-bold text-gray-700">Accessibility</span>
                                    </h5>
                                </td>
                            </tr>
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5 flex">
                                    <h5 class="text-sm lg:text-base font-medium text-gray-600 flex gap-1">
                                        <PlaneTakeoff size={28} stroke-width={1} /> Airport - <span class="font-bold text-gray-700 pr-1.5">30 km</span>
                                    </h5>
                                    <h5 class="text-sm lg:text-base font-medium text-gray-600 flex gap-1 border-l border-gray-200 pl-1.5">
                                        <Truck size={28} stroke-width={1} /> NH 44 - <span class="font-bold text-gray-700">1 km</span>
                                    </h5>
                                </td>
                            </tr>
                            <tr class="mt-2">
                                <td class="px-4 py-1.5 flex justify-end">
                                    <a href="#" class="flex-center gap-2 text-sm lg:text-base font-medium bg-[var(--secondary-clr-lit)] text-white px-4 py-1.5 rounded-full">
                                        <span class="">Explore Park</span>
                                        <SquareArrowUpRight size={18} stroke-width={1.5} />
                                    </a>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div id="location-three" class="flex flex-col p-5 gap-4 rounded-sm border border-gray-200 shadow-sm bg-white location-section">
