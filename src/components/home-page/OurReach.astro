                    </h5>
                    <div class="flex flex-col px-5 py-2 gap-3.5">
                        <table class="border border-gray-200 border-collapse">
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="text-[20px] font-bold text-gray-700">4 </span>Major Cities
                                    </h5>
                                </td>
                            </tr>
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="text-[20px] font-bold text-gray-700">25-100 Acres </span>Park Size
                                    </h5>
                                </td>
                            </tr>
                            <tr class="border border-gray-200">
                                <td class="px-4 py-1.5">
                                    <h5 class="text-sm md:text-base lg:text-lg font-medium text-gray-600">
                                        <span class="text-[20px] font-bold text-gray-700">434 Acres </span>Existing Landbank
                                    </h5>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div id="location-one" class="flex flex-col p-5 gap-4 rounded-sm border border-gray-200 shadow-sm bg-white location-section">
                    <div class="flex justify-between gap-6">
