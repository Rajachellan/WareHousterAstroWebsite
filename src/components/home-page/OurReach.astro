                    <div class="flex justify-between gap-6">
                        <h5 class="text-base md:text-lg lg:text-xl font-medium text-gray-800">
                            <span class="text-[17px] md:text-[19px] lg:text-[21px] font-bold text-gray-700">Grade - A park </span>| Shoolgiri, Hosur
                        </h5>
                        <label for="loc-0" class="flex px-2.5 py-1.5 text-sm lg:text-base font-semibold text-[#0D4B98] gap-2 top-[47%] left-[84.5%] cursor-pointer underline">
