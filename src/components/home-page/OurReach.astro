---
import { Box, PlaneTakeoff, Building2, SquareArrowUpRight, Truck } from "@lucide/astro";
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center mx-auto my-10 px-5">
    <div class="w-full col-center gap-5 max-w-6xl mt-16">
        <div class="col-center gap-2">
            <span class="flex-center gap-2 px-3.5 py-1 bg-white border border-[#e4e4e4] rounded-full">
                <Box size={18} stroke-width={2} class="text-gray-800" />
                <h2 class="text-[13px] md:text-[15px] font-medium  text-gray-800">
                    Our Reach
                </h2>
            </span>
            <h2 class="h2-bold text-center">
                Our Network of Smart Warehouses
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-400 md:text-gray-500 max-w-4xl text-center px-auto">
                Our smart warehouses span key industrial zones across India, designed for scalability and operational efficiency. Each site supports seamless logistics, modern infrastructure, and tailored storage solutions.
            </p>
        </div>
        <div class="w-full flex items-stretch justify-center gap-3.5 pt-9">

            <input type="radio" name="location" id="loc-0" class="hidden" >
            <input type="radio" name="location" id="loc-1" class="hidden">
            <input type="radio" name="location" id="loc-2" class="hidden" checked>
            <input type="radio" name="location" id="loc-3" class="hidden">
            <input type="radio" name="location" id="loc-4" class="hidden">

            <div class="w-1/2 flex items-center justify-start my-auto mr-auto">
                <div class="w-8/12 xl:9/12 relative">
                    <Image src="/images/upload/india-map-south.webp" alt="warehouster-south-indian-map" width={324} height={324} class="w-full" />
                    <label for="loc-1" class="absolute flex px-2.5 py-1.5 text-xs md:text-sm font-semibold text-[#0D4B98] gap-2 top-[47%] left-[84.5%] cursor-pointer">
                        <div class="h-5 w-5 rounded-full bg-[#1171B7] relative border-2 border-[#4F5574]">
                            <div class="absolute w-full h-full rounded-full top-0 left-0 bg-[#1789dab2] animate-ping -z-10 scale-150"></div>
                            <span class="absolute bottom-full left-full bg-[#ffffff7d] px-3.5 py-1 text-nowrap border border-gray-300 rounded-r-md rounded-tl-md">
                                Warehouse in Chennai
                            </span>
                        </div>
                    </label>
                    <label for="loc-2" class="absolute flex px-2.5 py-1.5 text-xs md:text-sm font-semibold text-[#0D4B98] gap-2 top-[43%] left-[65.5%] cursor-pointer">
                        <div class="h-5 w-5 rounded-full bg-[#1171B7] relative border-2 border-[#4F5574]">
                            <div class="absolute w-full h-full rounded-full top-0 left-0 bg-[#1789dab2] animate-ping -z-10 scale-150"></div>
                            <span class="absolute bottom-full right-full bg-[#ffffff7d] px-3.5 py-1 text-nowrap border border-gray-300 rounded-l-md rounded-tr-md">
                                Warehouse in Banglore
                            </span>
                        </div>
                    </label>
                    <label for="loc-3" class="absolute flex px-2.5 py-1.5 text-xs md:text-sm font-semibold text-[#0D4B98] gap-2 top-[70%] left-[72.5%] cursor-pointer">
                        <div class="h-5 w-5 rounded-full bg-[#1171B7] relative border-2 border-[#4F5574]">
                            <div class="absolute w-full h-full rounded-full top-0 left-0 bg-[#1789dab2] animate-ping -z-10 scale-150"></div>
                            <span class="absolute bottom-full left-full bg-[#ffffff7d] px-3.5 py-1 text-nowrap border border-gray-300 rounded-r-md rounded-tl-md">
                                Warehouse in Madurai
                            </span>
                        </div>
                    </label>
                    <label for="loc-4" class="absolute flex px-2.5 py-1.5 text-xs md:text-sm font-semibold text-[#0D4B98] gap-2 top-[50.8%] left-[69.9%] cursor-pointer">
