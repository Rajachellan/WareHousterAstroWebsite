                        <div class="flex justify-between gap-3.5 text-sm lg:text-base text-gray-800 font-semibold px-2.5">
                            <div class="">
                                <p class="text-gray-600 leading-tight">
                                    Land area
                                </p>
                                30 <span class="text-gray-400">Acres</span>
                            </div>
                            <div class="">
                                <p class="text-gray-600 leading-tight">
                                    Development
                                </p>
                                0.65 <span class="text-gray-400">MN SQ FT</span>
                            </div>
                            <div class="">
