---
import { Box } from "@lucide/astro";
import Image from "astro/components/Image.astro";
---

<section class="w-full col-center mx-auto my-10 gap-14">
    <div class="w-full col-center gap-1 max-w-7xl mt-8 lg:mt-12 xl:mt-16">
        <div class="col-center gap-2">
            <span class="flex-center gap-2 px-3.5 py-1 bg-white border border-[#e4e4e4] rounded-full">
                <Box size={18} stroke-width={2} class="text-gray-800" />
                <h2 class="text-[13px] md:text-[15px] font-medium  text-gray-800">
                    Team & Awards
                </h2>
            </span>
            <h2 class="h2-bold text-center">
                The Minds and Milestones Behind Our Success
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-400 md:text-gray-500 max-w-4xl text-center px-auto">
                From visionary leadership to industry accolades, this section celebrates the people and achievements that define our journey. Meet the team driving innovation—and explore the recognitions that reflect our impact.
            </p>
        </div>
    </div>
    
    <div class="w-full flex items-stretch justify-stretch mt-12 mb-8">
        <div class="w-1/4 overflow-hidden relative">
            <Image src="/images/upload/Sandeep.webp" alt="ceo-image" width={450} height={590} class="w-full" />
            <div class="absolute flex-center w-full bg-linear-to-t from-black to-[rgba(0,0,0,0.02)] py-1.5 lg:py-3.5 bottom-0 left-0">
                <p class="text-sm md:text-base lg:text-lg xl:text-xl font-medium lg:font-semibold text-white text-center">
                    <span class="block">Sandeep Chadha</span>
                    <span class="block text-[var(--primary-color)] text-xs lg:text-base text-center">Founder & CEO</span>
                </p>
            </div>
        </div>
        <div class="w-3/4 flex items-start justify-center relative pl-8 bg-white">
            <div class="w-full col-center">
                <input type="radio" name="manag" id="mag-1" class="hidden" checked>
                <input type="radio" name="manag" id="mag-2" class="hidden">

                <div class="w-full flex-center border-b border-gray-300 tab-list">
                    <div class="max-w-full w-full overflow-x-scroll rounded-t-md px-4.5 relative" id="scroller" style="-ms-overflow-style: none; scrollbar-width: none; scroll-behavior:smooth;" >
                        <ul class="flex flex-nowrap justify-start gap-8 md:gap-10 whitespace-nowrap text-sm lg:text-base leading-snug font-semibold text-[#05070b] py-1.5 px-1.5">
                            <li class="flex-none">
                                <label for="mag-1" class="text-sm md:text-base inline-block py-4.5 cursor-pointer hover:text-[var(--primary-color)]">Management Team</label>
                            </li>
                            <li class="flex-none">
                                <label for="mag-2" class="text-sm md:text-base inline-block py-4.5 cursor-pointer hover:text-[var(--primary-color)]">Awards</label>
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- 3. Management and Award content stack -->
                <div class="w-full h-auto relative py-3.5 px-1">
                    <div id="manag-one" class="w-full h-fit flex items-center justify-start manag-section gap-3.5">
                        <div class="flex items-stretch justify-center gap-9">
                            <div class="w-1/4 max-w-48 lg:max-w-80 flex flex-col items-start justify-center gap-4 group px-5 py-4">
                                <Image src="/images/upload/kannadhassun-rounded.webp" alt="abc" width={555} height={554} class="rounded-full" />
                                <div class="flex flex-col items-start justify-center px-1">
                                    <p class="text-[8px] md:text-[10px] lg:text-xs xl:text-sm text-gray-500">Visionary in Urban Development</p>
                                    <p class="capitalize text-sm lg:text-lg font-medium text-left pt-1">kannadhassun</p>
                                    <p class="capitalize text-[10px] md:text-xs xl:text-sm text-[var(--primary-color)] text-left font-medium">Head Const & Projects</p>
                                </div>
                            </div>
                            <div class="w-1/4 max-w-48 lg:max-w-80 flex flex-col items-start justify-center gap-4 group px-5 py-4">
                                <Image src="/images/upload/kaushik-vora-rounded.webp" alt="abc" width={555} height={554} class="rounded-full" />
                                <div class="flex flex-col items-start justify-center px-1 gap-0.5">
                                    <p class="text-[8px] md:text-[10px] lg:text-xs xl:text-sm text-gray-500">Leadership in Asset Structuring</p>
                                    <p class="capitalize lg:text-lg font-medium text-left pt-1">kaushik vora</p>
                                    <p class="capitalize text-[10px] md:text-xs xl:text-sm text-[var(--primary-color)] text-left font-medium">Investments</p>
                                </div>
                            </div>
                            <div class="w-1/4 max-w-48 lg:max-w-80 flex flex-col items-start justify-center gap-4 group px-5 py-4">
                                <Image src="/images/upload/divyansh-jain-rounded.webp" alt="abc" width={555} height={554} class="rounded-full" />
                                <div class="flex flex-col items-start justify-center px-1 gap-0.5">
                                    <p class="text-[8px] md:text-[10px] lg:text-xs xl:text-sm text-gray-500">Valuation-Led Real Estate Vision</p>
                                    <p class="capitalize lg:text-lg font-medium text-left pt-1">divyansh jain</p>
                                    <p class="capitalize text-[10px] md:text-xs xl:text-sm text-[var(--primary-color)] text-left font-medium">Leasing & Asset Management</p>
                                </div>
                            </div>
                            <div class="w-1/4 max-w-48 lg:max-w-80 flex flex-col items-start justify-center gap-4 group px-5 py-4">
                                <Image src="/images/upload/debi-sarangi-rounded.webp" alt="abc" width={555} height={554} class="rounded-full" />
                                <div class="flex flex-col items-start justify-center px-1 gap-0.5">
                                    <p class="text-[8px] md:text-[10px] lg:text-xs xl:text-sm text-gray-500">21 Years of Legal Impact</p>
                                    <p class="capitalize lg:text-lg font-medium text-left pt-1">Debi Sarangi</p>
                                    <p class="capitalize text-[10px] md:text-xs xl:text-sm text-[var(--primary-color)] text-left font-medium">Head Legal</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="manag-two" class="w-full h-fit flex items-stretch justify-start manag-section gap-3.5">
                        <div class="w-1/3 max-w-48 lg:max-w-[375px] flex flex-col items-start justify-start gap-4 group px-5 py-4">
                            <Image src="/images/upload/awards/magazine-emerging-cargo-awards.webp" alt="magazine-emerging-cargo-awards" width={700} height={450} class="rounded-sm" />
                            <div class="flex flex-col items-start justify-center px-1">
                                <p class="capitalize lg:text-lg font-medium text-left pt-1">MAGAZINE EMERGING INDUSTRIAL & LOGISTICS DEVELOPER BY INDIA CARGO AWARDS</p>
                            </div>
                        </div>
                        <div class="w-1/3 max-w-48 lg:max-w-[375px] flex flex-col items-start justify-start gap-4 group px-5 py-4">
                            <Image src="/images/upload/awards/warehousing-asset-manag-startup-2021.webp" alt="warehousing-asset-manag-startup-2021" width={700} height={450} class="rounded-sm" />
                            <div class="flex flex-col items-start justify-center px-1 gap-0.5">
                                <p class="capitalize lg:text-lg font-medium text-left pt-1">WAREHOUSING ASSET MANAGEMENT STARTUP OF THE YEAR 2021</p>
                            </div>
                        </div>
                        <div class="w-1/3 max-w-48 lg:max-w-[375px] flex flex-col items-start justify-start gap-4 group px-5 py-4">
                            <Image src="/images/upload/awards/featured-in-india-davos-2024-magazine.webp" alt="featured-in-india-davos-2024-magazine" width={700} height={450} class="rounded-sm" />
                            <div class="flex flex-col items-start justify-center px-1 gap-0.5">
                                <p class="capitalize lg:text-lg font-medium text-left pt-1">FEATURED IN "INDIA @DAVOS 2024" MAGAZINE</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>