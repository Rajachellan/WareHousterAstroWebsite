---
import { MapPinHouse, Megaphone, LayoutDashboard, BriefcaseBusiness, Box } from "@lucide/astro";
---

<>
<section class="w-full flex-center mx-auto my-5 md:my-12 px-4">
    <div class="w-full col-center gap-14 max-w-7xl mt-8 md:mt-16">
        <div class="col-center gap-2">
            <span class="flex-center gap-2 px-3.5 py-1 bg-white border border-[#e4e4e4] rounded-full">
                <Box size={18} stroke-width={2} class="text-gray-800" />
                <h4 class="text-[13px] md:text-[15px] font-medium  text-gray-800">
                    About
                </h4>
            </span>
            <h2 class="h2-bold text-center">
                About Warehouster Group
            </h2>
            <p class="text-sm lg:text-base leading-snug text-gray-500 max-w-3xl text-justify md:text-center px-auto">
                Warehouster is India’s integrated logistics asset partner—specializing in acquisition, development, and portfolio management for global and domestic investors.
            </p>
        </div>
        <div class="w-full col-center gap-4 md:gap-5">
            <div class="w-full flex-stretch gap-4 md:gap-5">
                <div class="w-full md:w-3/5 py-4 md:py-5 lg:py-6 px-5 md:px-6 lg:px-8 xl:px-9 flex flex-col items-start justify-between bg-white border border-[#dcdcdc] rounded-xl">
                    <div class="w-9 text-[var(--primary-color)] pb-7">
                        <MapPinHouse size="100%" stroke-width={1}  />
                    </div>
                    <div class="flex flex-col items-start">
                        <h3 class="h3-md pb-2.5 md:pb-3 lg:pb-4">Land & Liasioning</h3>
                        <p class="text-base lg:text-lg leading-snug text-gray-500">
                            Warehouster sources strategic, compliant industrial land across high-growth regions—tailored to customer expansion goals and landlord terms. Our logistics parks meet global standards with zero tolerance for non-compliance.
                        </p>
                    </div>
                </div>
                <div class="w-full md:w-2/5 py-4 md:py-5 lg:py-6 px-5 md:px-6 lg:px-8 xl:px-9 flex flex-col items-start justify-between bg-white border border-[#dcdcdc] rounded-xl">
                    <div class="w-9 text-[var(--primary-color)] pb-7">
                        <Megaphone size="100%" stroke-width={1}  />
                    </div>
                    <div class="flex flex-col items-start">
                        <h3 class="h3-md pb-2.5 md:pb-3 lg:pb-4">Leasing & Marketing</h3>
                        <p class="lg:text-lg leading-snug text-gray-500">
                            Warehouster delivers on-time, customized industrial buildings and scalable logistics parks for warehousing, manufacturing, and business expansion.
                        </p>
                    </div>
                </div>
            </div>
            <div class="w-full flex-stretch gap-4 md:gap-5">
                <div class="w-full md:w-2/5 py-4 md:py-5 lg:py-6 px-5 md:px-6 lg:px-8 xl:px-9 flex flex-col items-start justify-between bg-white border border-[#dcdcdc] rounded-xl">
                    <div class="w-9 text-[var(--primary-color)] pb-7">
                        <BriefcaseBusiness size="100%" stroke-width={1}  />
                    </div>
                    <div class="flex flex-col items-start">
                        <h3 class="h3-md pb-2.5 md:pb-3 lg:pb-4">Asset Management</h3>
                        <p class="lg:text-lg leading-snug text-gray-500">
                            Warehouster drives superior returns through strategic fund management in warehousing and industrial real estate, backed by multi-million dollar portfolios.
                        </p>
                    </div>
                </div>
                <div class="w-full md:w-3/5 py-4 md:py-5 lg:py-6 px-5 md:px-6 lg:px-8 xl:px-9 flex flex-col items-start justify-between bg-white border border-[#dcdcdc] rounded-xl">
                    <div class="w-9 text-[var(--primary-color)] pb-7">
                        <LayoutDashboard size="100%" stroke-width={1}  />
                    </div>
                    <div class="flex flex-col items-start">
                        <h3 class="h3-md pb-2.5 md:pb-3 lg:pb-4">Development Management</h3>
                        <p class="lg:text-lg leading-snug text-gray-500">
                            Warehouster’s development management program helps landowners and fund houses unlock warehousing ROI, logistics returns, and industrial real estate value while retaining ownership. We deliver turnkey Grade-A assets and manage operations with no in-house team required.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</>